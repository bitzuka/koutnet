# Not a singleton: koutnet::AppSettings derives from this class to add the
# group passphrase, which belongs in KWallet and not in a config file.
File=koutnetsettings.kcfg
ClassName=KOutNetSettings
Mutators=true
DefaultValueGetters=true
GenerateProperties=true
Notifiers=true
