msgstr "Кто-то"

#: src/matrix/MatrixTranslate.cpp:51
msgctxt "@info in-timeline notice, a room member with no resolvable name"
msgid "someone"
msgstr "кто-то"

#: src/matrix/MatrixTranslate.cpp:57
msgctxt "@info in-timeline notice, %1 is a room member"
msgid "%1 joined the room."
msgstr "%1 присоединился к комнате."

#: src/matrix/MatrixTranslate.cpp:59
msgctxt "@info in-timeline notice, %1 is a room member"
msgid "%1 left the room."
msgstr "%1 покинул(а) комнату."

#: src/matrix/MatrixTranslate.cpp:61
msgctxt "@info in-timeline notice, %1 invited %2"
msgid "%1 invited %2."
msgstr "%1 пригласил(а) %2."

#: src/matrix/MatrixTranslate.cpp:63
msgctxt "@info in-timeline notice, %1 took back an invitation to %2"
msgid "%1 withdrew the invitation to %2."
msgstr "%1 отозвал(а) приглашение для %2."

#: src/matrix/MatrixTranslate.cpp:65
msgctxt "@info in-timeline notice, %1 is a room member"
msgid "%1 declined the invitation."
msgstr "%1 отклонил(а) приглашение."

#: src/matrix/MatrixTranslate.cpp:67
msgctxt "@info in-timeline notice, %1 removed %2 from the room"
msgid "%1 removed %2 from the room."
msgstr "%1 удалил(а) %2 из комнаты."

#: src/matrix/MatrixTranslate.cpp:69
msgctxt "@info in-timeline notice, %1 banned %2"
msgid "%1 banned %2 from the room."
msgstr "%1 заблокировал(а) %2 в комнате."

#: src/matrix/MatrixTranslate.cpp:71
msgctxt "@info in-timeline notice, %1 is a room member"
msgid "%1 banned themselves from the room."
msgstr "%1 заблокировал(а) себя в комнате."

#: src/matrix/MatrixTranslate.cpp:73
msgctxt "@info in-timeline notice, %1 lifted a ban on %2"
msgid "%1 unbanned %2."
msgstr "%1 разблокировал(а) %2."

#: src/matrix/MatrixTranslate.cpp:75
msgctxt "@info in-timeline notice, %1 is a room member"
msgid "%1 lifted their own ban."
msgstr "%1 снял(а) свою блокировку."

#: src/matrix/MatrixTranslate.cpp:77
msgctxt "@info in-timeline notice, %1 asked to be let into the room"
msgid "%1 asked for an invitation."
msgstr "%1 запросил(а) приглашение."

