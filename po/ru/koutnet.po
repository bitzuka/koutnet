#: src/qml/matrix/DeviceVerificationDialog.qml:24
msgctxt "@title:dialog"
msgid "Verify session"
msgstr "Проверить сеанс"

#: src/qml/matrix/DeviceVerificationDialog.qml:78
msgctxt "@info:whatsthis"
msgid ""
"Verifying tells your other sessions that this one is really yours, so they "
"will send it the keys "
msgstr "Проверка сообщает вашим другим сеансам, что этот сеанс действительно ваш, поэтому они отправят ему ключи "

#: src/qml/matrix/DeviceVerificationDialog.qml:89
msgctxt "@info the other client has to be open at the same time"
msgid "The other session has to be signed in and open while you do this."
msgstr "Другой сеанс должен быть открыт и в него должен быть выполнен вход, пока вы это делаете."

#: src/qml/matrix/DeviceVerificationDialog.qml:119
msgctxt "@item a Matrix session, %1 is its name and %2 its device id"
msgid "%1 (%2)"
msgstr "%1 (%2)"

#: src/qml/matrix/DeviceVerificationDialog.qml:129
msgctxt "@info:status this session is already verified"
msgid "Already verified"
msgstr "Уже проверено"

#: src/qml/matrix/DeviceVerificationDialog.qml:130
msgctxt "@info:status this session has not been verified"
msgid "Not verified"
msgstr "Не проверено"

#: src/qml/matrix/DeviceVerificationDialog.qml:138
msgctxt "@action:button start verifying another of your sessions"
msgid "Verify"
msgstr "Проверить"

#: src/qml/matrix/DeviceVerificationDialog.qml:150
msgctxt "@info:status this account has no other sessions to verify against"
msgid ""
"This account has no other sessions. Sign in with another Matrix client "
"first, then come back here."
msgstr "У этой учётной записи нет других сеансов. Сначала войдите в другой Matrix-клиент, а затем вернитесь сюда."

#: src/qml/matrix/DeviceVerificationDialog.qml:152
msgctxt "@info:status verification needs a working key store"
msgid ""
"This session could not open its encryption keys, so it cannot be verified. "
"Check that the wallet is running and sign in again."
msgstr "Этот сеанс не смог открыть свои ключи шифрования, поэтому его нельзя проверить. Убедитесь, что хранилище паролей запущено, и войдите снова."

#: src/qml/matrix/DeviceVerificationDialog.qml:164
msgctxt "@action:button ask every already-verified session at once"
msgid "Ask all verified sessions"
msgstr "Запросить все проверенные сеансы"

#: src/qml/matrix/DeviceVerificationDialog.qml:179
msgctxt "@info another Matrix user asked to verify, %1 is their user id"
msgid "%1 wants to verify with you."
msgstr "%1 хочет выполнить проверку с вами."

#: src/qml/matrix/DeviceVerificationDialog.qml:181
msgctxt ""
"@info another session of this account asked to verify, %1 is a device id"
msgid "Session %1 wants to verify with this one."
msgstr "Сеанс %1 хочет выполнить проверку с этим."

#: src/qml/matrix/DeviceVerificationDialog.qml:189
msgctxt "@info:whatsthis"
msgid "Only accept this if you started it yourself on the other session."
msgstr "Принимайте это, только если вы сами начали проверку на другом сеансе."

#: src/qml/matrix/DeviceVerificationDialog.qml:325
msgctxt "@action:button accept an incoming verification request"
msgid "Accept"
msgstr "Принять"

#: src/qml/matrix/DeviceVerificationDialog.qml:331
msgctxt "@action:button the emoji on both sessions are the same"
msgid "They match"
msgstr "Они совпадают"

#: src/qml/matrix/DeviceVerificationDialog.qml:337
msgctxt "@action:button the emoji on the two sessions differ"
msgid "They do not match"
msgstr "Они не совпадают"

#: src/qml/matrix/DeviceVerificationDialog.qml:343
msgctxt "@action:button abandon a verification in progress"
msgid "Cancel"
msgstr "Отмена"

#: src/qml/matrix/DeviceVerificationDialog.qml:350
msgctxt "@action:button close the verification dialog after it finished"
msgid "Done"
msgstr "Готово"

#: src/qml/matrix/DeviceVerificationDialog.qml:351
msgctxt "@action:button close the verification dialog"
msgid "Close"
msgstr "Закрыть"

