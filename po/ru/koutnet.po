#: src/matrix/MatrixManager.cpp:93
msgctxt "@info:status Matrix login stalled after the password was accepted"
msgid ""
"The sign-in was accepted but the encryption keys could not be opened in "
"time. Unlock the wallet if it is asking, and try again."
msgstr "Вход был принят, но ключи шифрования не удалось открыть вовремя. Разблокируйте хранилище паролей, если появится запрос, и повторите попытку."

#: src/matrix/MatrixManager.cpp:96
msgctxt "@info:status Matrix login failed"
msgid ""
"The homeserver did not answer in time. Nothing was signed in; the attempt is "
"still running and will report itself in the log."
msgstr "Хоум-сервер не ответил вовремя. Вход не выполнен; попытка продолжается и сообщит о результате в журнале."

#: src/matrix/MatrixManager.cpp:144
msgctxt "@info:status Matrix connection state"
msgid "Not signed in"
msgstr "Не выполнен вход"

#: src/matrix/MatrixManager.cpp:146
msgctxt "@info:status Matrix connection state"
msgid "Signing in..."
msgstr "Выполняется вход..."

#: src/matrix/MatrixManager.cpp:148
msgctxt "@info:status Matrix connection state"
msgid "Syncing..."
msgstr "Синхронизация..."

#: src/matrix/MatrixManager.cpp:150
msgctxt "@info:status Matrix connection state, %1 is a Matrix user id"
msgid "Signed in as %1"
msgstr "Выполнен вход как %1"

#: src/matrix/MatrixManager.cpp:153
msgctxt "@info:status Matrix connection state"
msgid "Reconnecting..."
msgstr "Переподключение..."

#: src/matrix/MatrixManager.cpp:154
msgctxt ""
"@info:status Matrix connection state, %1 is what the homeserver or the "
"network reported"
msgid "Reconnecting after: %1"
msgstr "Переподключение после: %1"

#: src/matrix/MatrixManager.cpp:158
msgctxt "@info:status Matrix connection state"
msgid "Sign-in failed"
msgstr "Ошибка входа"

#: src/matrix/MatrixManager.cpp:212
msgctxt ""
"@info:status the Matrix session could not set up its encryption key store"
msgid ""
"Encryption could not be started for this session, so encrypted rooms will "
"stay unreadable. This usually means the wallet could not be opened."
msgstr "Шифрование для этого сеанса не удалось запустить, поэтому зашифрованные комнаты останутся нечитаемыми. Обычно это значит, что не удалось открыть хранилище паролей."

#: src/matrix/MatrixManager.cpp:237
msgctxt ""
"@info:status a stored Matrix session was refused, %1 is what the homeserver "
"said"
msgid "The saved sign-in is no longer accepted (%1). Sign in again."
msgstr "Сохранённый вход больше не принимается (%1). Войдите снова."

#: src/matrix/MatrixManager.cpp:280
msgctxt "@info:status"
msgid "The homeserver signed this device out."
msgstr "Хоум-сервер завершил сеанс этого устройства."

#: src/matrix/MatrixManager.cpp:321
msgctxt "@info:status Matrix sync gave up with nothing reported"
msgid "The homeserver stopped answering; no messages are arriving."
msgstr "Хоум-сервер перестал отвечать; сообщения не поступают."

#: src/matrix/MatrixManager.cpp:322
msgctxt "@info:status Matrix sync gave up, %1 is what libQuotient reported"
msgid "Syncing failed: %1"
msgstr "Синхронизация не удалась: %1"

#: src/matrix/MatrixManager.cpp:364
msgctxt "@info:status"
msgid "No recovery key or passphrase was given."
msgstr "Не указан ключ восстановления или парольная фраза."

#: src/matrix/MatrixManager.cpp:369
msgctxt "@info:status"
msgid "That did not unlock the room key backup."
msgstr "Это не разблокировало резервную копию ключей комнаты."

#: src/matrix/MatrixManager.cpp:383
msgctxt "@info:status Matrix login"
msgid "A user name and a password are needed."
msgstr "Требуются имя пользователя и пароль."

#: src/matrix/MatrixManager.cpp:415
msgctxt "@info:status Matrix login"
msgid "Give a homeserver, or write the user ID in full as @name:server."
msgstr "Укажите хоум-сервер или введите идентификатор пользователя целиком в формате @name:server."

#: src/matrix/MatrixManager.cpp:485
msgctxt ""
"@info:status a homeserver typed by hand did not answer usefully, %1 is that "
"address"
msgid ""
"%1 did not offer a password sign-in. Check the address, or turn on following "
"the server's redirect so that the address it publishes is used instead."
msgstr "%1 не предложил вход по паролю. Проверьте адрес или включите следование перенаправлению сервера, чтобы использовался публикуемый им адрес."

#: src/matrix/MatrixManager.cpp:515
msgctxt "@info:status a stored Matrix session could not be reopened"
msgid ""
"The saved sign-in could not be read back from the wallet. Sign in again."
msgstr "Сохранённый вход не удалось прочитать из хранилища паролей. Войдите снова."

#: src/matrix/MatrixManager.cpp:552
msgctxt ""
"@info:status %1 is the account the token belongs to, %2 the account the "
"configuration expected"
msgid "The saved sign-in belongs to %1, not %2. Sign in again."
msgstr "Сохранённый вход принадлежит %1, а не %2. Войдите снова."

#: src/matrix/MatrixRoomBridge.cpp:123
msgctxt ""
"@info:status a message for an encrypted room was not sent because the "
"session has no keys"
msgid ""
"This room is end-to-end encrypted and this session could not open its "
"encryption keys, so nothing was sent."
msgstr "Эта комната использует сквозное шифрование, а этот сеанс не смог открыть свои ключи шифрования, поэтому ничего не отправлено."

#: src/matrix/MatrixRoomBridge.cpp:710
msgctxt "@info:status a Matrix message was not accepted and nothing said why"
msgid "The message could not be sent to this room."
msgstr "Сообщение не удалось отправить в эту комнату."

#: src/matrix/MatrixRoomBridge.cpp:711
msgctxt ""
"@info:status a Matrix message was not accepted, %1 is what the homeserver "
"reported"
msgid "The message could not be sent: %1"
msgstr "Сообщение не удалось отправить: %1"

#: src/matrix/MatrixRoomBridge.cpp:767
msgctxt "@info:status"
msgid "Not signed in to Matrix, so this message was not sent."
msgstr "Вход в Matrix не выполнен, поэтому сообщение не отправлено."

#: src/matrix/MatrixRoomBridge.cpp:773 src/matrix/MatrixRoomBridge.cpp:792
msgctxt "@info:status"
msgid "That Matrix room is not available in this session."
msgstr "Эта комната Matrix недоступна в этом сеансе."

#: src/matrix/MatrixRoomBridge.cpp:802
msgctxt "@info:status %1 is a file name"
msgid "%1 could not be read, so nothing was sent."
msgstr "Не удалось прочитать %1, поэтому ничего не отправлено."

