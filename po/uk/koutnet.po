#: src/matrix/MatrixManager.cpp:96
msgctxt "@info:status Matrix login stalled after the password was accepted"
msgid ""
"The sign-in was accepted but the encryption keys could not be opened in "
"time. Unlock the wallet if it is asking, and try again."
msgstr ""
"Вхід було прийнято, але ключі шифрування не вдалося відкрити вчасно. "
"Розблокуйте гаманець, якщо він запитує, і спробуйте ще раз."

#: src/matrix/MatrixManager.cpp:99
msgctxt "@info:status Matrix login failed"
msgid ""
"The homeserver did not answer in time. Nothing was signed in; the attempt is "
"still running and will report itself in the log."
msgstr ""
"Сервер не відповів вчасно. Вхід не виконано; спроба триває і повідомить про "
"себе у журналі."

#: src/matrix/MatrixManager.cpp:152
msgctxt "@info:status Matrix connection state"
msgid "Not signed in"
msgstr "Не виконано вхід"

#: src/matrix/MatrixManager.cpp:154
msgctxt "@info:status Matrix connection state"
msgid "Signing in..."
msgstr "Виконуємо вхід…"

#: src/matrix/MatrixManager.cpp:156
msgctxt "@info:status Matrix connection state"
msgid "Syncing..."
msgstr "Синхронізація…"

#: src/matrix/MatrixManager.cpp:158
msgctxt "@info:status Matrix connection state, %1 is a Matrix user id"
msgid "Signed in as %1"
msgstr "Виконано вхід як %1"

#: src/matrix/MatrixManager.cpp:161
msgctxt "@info:status Matrix connection state"
msgid "Reconnecting..."
msgstr "Перепідключення…"

#: src/matrix/MatrixManager.cpp:162
msgctxt ""
"@info:status Matrix connection state, %1 is what the homeserver or the "
"network reported"
msgid "Reconnecting after: %1"
msgstr "Перепідключення після: %1"

#: src/matrix/MatrixManager.cpp:166
msgctxt "@info:status Matrix connection state"
msgid "Sign-in failed"
msgstr "Не вдалося виконати вхід"

#: src/matrix/MatrixManager.cpp:220
msgctxt ""
"@info:status the Matrix session could not set up its encryption key store"
msgid ""
"Encryption could not be started for this session, so encrypted rooms will "
"stay unreadable. This usually means the wallet could not be opened."
msgstr ""
"Не вдалося запустити шифрування для цього сеансу, тому зашифровані кімнати "
"залишатимуться нечитабельними. Зазвичай це означає, що гаманець не вдалося "
"відкрити."

#: src/matrix/MatrixManager.cpp:245
msgctxt ""
"@info:status a stored Matrix session was refused, %1 is what the homeserver "
"said"
msgid "The saved sign-in is no longer accepted (%1). Sign in again."
msgstr "Збережений вхід більше не приймається (%1). Увійдіть знову."

#: src/matrix/MatrixManager.cpp:288
msgctxt "@info:status"
msgid "The homeserver signed this device out."
msgstr "Сервер завершив сеанс цього пристрою."

#: src/matrix/MatrixManager.cpp:329
msgctxt "@info:status Matrix sync gave up with nothing reported"
msgid "The homeserver stopped answering; no messages are arriving."
msgstr "Сервер перестав відповідати; повідомлення не надходять."

#: src/matrix/MatrixManager.cpp:330
msgctxt "@info:status Matrix sync gave up, %1 is what libQuotient reported"
msgid "Syncing failed: %1"
msgstr "Не вдалося синхронізуватися: %1"

#: src/matrix/MatrixManager.cpp:376
msgctxt "@info:status"
msgid "No recovery key or passphrase was given."
msgstr "Не вказано ключ відновлення або парольну фразу."

#: src/matrix/MatrixManager.cpp:381
msgctxt "@info:status"
msgid "That did not unlock the room key backup."
msgstr "Це не відкрило резервну копію ключів кімнати."

#: src/matrix/MatrixManager.cpp:401
msgctxt "@info:status Matrix login"
msgid "A user name and a password are needed."
msgstr "Потрібні ім'я користувача та пароль."

#: src/matrix/MatrixManager.cpp:433
msgctxt "@info:status Matrix login"
msgid "Give a homeserver, or write the user ID in full as @name:server."
msgstr ""
"Вкажіть сервер або запишіть ідентифікатор користувача повністю у вигляді "
"@name:server."

#: src/matrix/MatrixManager.cpp:503
msgctxt ""
"@info:status a homeserver typed by hand did not answer usefully, %1 is that "
"address"
msgid ""
"%1 did not offer a password sign-in. Check the address, or turn on following "
"the server's redirect so that the address it publishes is used instead."
msgstr ""
"%1 не запропонував вхід за паролем. Перевірте адресу або увімкніть перехід "
"за перенаправленням сервера, щоб використовувалася адреса, яку він публікує."

#: src/matrix/MatrixManager.cpp:533
msgctxt "@info:status a stored Matrix session could not be reopened"
msgid ""
"The saved sign-in could not be read back from the wallet. Sign in again."
msgstr "Не вдалося прочитати збережений вхід з гаманця. Увійдіть знову."

#: src/matrix/MatrixManager.cpp:570
msgctxt ""
"@info:status %1 is the account the token belongs to, %2 the account the "
"configuration expected"
msgid "The saved sign-in belongs to %1, not %2. Sign in again."
msgstr "Збережений вхід належить %1, а не %2. Увійдіть знову."

#: src/matrix/MatrixManager.cpp:614
msgctxt "@info:status Matrix SSO login"
msgid "Choose a homeserver before completing SSO sign-in."
msgstr "Оберіть сервер домену перед завершенням входу через SSO."

#: src/matrix/MatrixManager.cpp:623
msgctxt "@info:status Matrix SSO login"
msgid "A login token is needed to sign in."
msgstr "Для входу потрібен маркер авторизації."

#: src/matrix/MatrixRoomBridge.cpp:124
msgctxt ""
"@info:status a message for an encrypted room was not sent because the "
"session has no keys"
msgid ""
"This room is end-to-end encrypted and this session could not open its "
"encryption keys, so nothing was sent."
msgstr ""
"Ця кімната має наскрізне шифрування, і цей сеанс не зміг відкрити свої ключі "
"шифрування, тому нічого не надіслано."

#: src/matrix/MatrixRoomBridge.cpp:865
msgctxt "@info:status a Matrix message was not accepted and nothing said why"
msgid "The message could not be sent to this room."
msgstr "Не вдалося надіслати повідомлення до цієї кімнати."

#: src/matrix/MatrixRoomBridge.cpp:866
